:root {
  --primary: #2d7a3e;
  --primary-dark: #1f5c2e;
  --primary-light: #4a9d5e;
  --secondary: #8b5a3c;
  --bg: #f8faf9;
  --surface: #ffffff;
  --text: #1a1a1a;
  --text-light: #666666;
  --border: #e0e0e0;
  --success: #2d7a3e;
  --warning: #f59e0b;
  --danger: #dc2626;
  --shadow: rgba(0, 0, 0, 0.1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  background: var(--bg);
  color: var(--text);
  line-height: 1.6;
}

.app {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Header */
.header {
  background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
  color: white;
  padding: 1.5rem 2rem;
  box-shadow: 0 2px 8px var(--shadow);
}

.header h1 {
  font-size: 1.8rem;
  font-weight: 700;
  margin-bottom: 0.25rem;
}

.header p {
  opacity: 0.9;
  font-size: 0.95rem;
}

/* Main container */
.container {
  flex: 1;
  display: grid;
  grid-template-columns: 400px 1fr 350px;
  gap: 1.5rem;
  padding: 1.5rem;
  max-width: 1800px;
  margin: 0 auto;
  width: 100%;
}

/* Cards */
.card {
  background: var(--surface);
  border-radius: 12px;
  box-shadow: 0 2px 8px var(--shadow);
  padding: 1.5rem;
  height: fit-content;
}

.card h2 {
  font-size: 1.3rem;
  margin-bottom: 1rem;
  color: var(--primary-dark);
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.card h3 {
  font-size: 1.1rem;
  margin-bottom: 0.75rem;
  color: var(--text);
}

/* Form */
.form-group {
  margin-bottom: 1rem;
}

label {
  display: block;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: var(--text);
  font-size: 0.95rem;
}

textarea,
select,
input {
  width: 100%;
  padding: 0.75rem;
  border: 2px solid var(--border);
  border-radius: 8px;
  font-size: 0.95rem;
  font-family: inherit;
  transition: all 0.2s;
}

textarea {
  resize: vertical;
  min-height: 120px;
}

textarea:focus,
select:focus,
input:focus {
  outline: none;
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(45, 122, 62, 0.1);
}

.btn {
  padding: 0.875rem 1.5rem;
  background: var(--primary);
  color: white;
  border: none;
  border-radius: 8px;
  font-size: 1rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s;
  width: 100%;
}

.btn:hover {
  background: var(--primary-dark);
  transform: translateY(-1px);
  box-shadow: 0 4px 12px rgba(45, 122, 62, 0.3);
}

.btn:active {
  transform: translateY(0);
}

.btn:disabled {
  background: #ccc;
  cursor: not-allowed;
  transform: none;
}

/* Matches list */
.matches-list {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-height: calc(100vh - 300px);
  overflow-y: auto;
}

.match-item {
  padding: 1rem;
  border: 2px solid var(--border);
  border-radius: 8px;
  cursor: pointer;
  transition: all 0.2s;
  background: var(--bg);
}

.match-item:hover {
  border-color: var(--primary);
  background: var(--surface);
  transform: translateX(4px);
}

.match-item.selected {
  border-color: var(--primary);
  background: var(--surface);
  box-shadow: 0 2px 8px rgba(45, 122, 62, 0.2);
}

.match-header {
  display: flex;
  justify-content: space-between;
  align-items: start;
  margin-bottom: 0.5rem;
}

.match-title {
  font-weight: 600;
  color: var(--primary-dark);
  font-size: 0.95rem;
  flex: 1;
}

.relevance-badge {
  background: var(--primary);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.85rem;
  font-weight: 600;
}

.match-meta {
  display: flex;
  gap: 1rem;
  font-size: 0.85rem;
  color: var(--text-light);
  margin-bottom: 0.5rem;
}

.match-evidence {
  font-size: 0.9rem;
  color: var(--text-light);
  font-style: italic;
  line-height: 1.5;
}

/* Recommendations */
.recommendation-section {
  margin-top: 1rem;
}

.rec-bullets {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.rec-bullets li {
  padding: 0.875rem;
  background: var(--bg);
  border-left: 3px solid var(--primary);
  border-radius: 6px;
  font-size: 0.95rem;
  line-height: 1.5;
}

.fallback-badge {
  display: inline-block;
  background: var(--warning);
  color: white;
  padding: 0.25rem 0.75rem;
  border-radius: 12px;
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 0.75rem;
}

.citations {
  margin-top: 1rem;
  padding-top: 1rem;
  border-top: 1px solid var(--border);
}

.citations h4 {
  font-size: 0.9rem;
  color: var(--text-light);
  margin-bottom: 0.5rem;
}

.citation {
  font-size: 0.85rem;
  color: var(--text-light);
  padding: 0.5rem;
  background: var(--bg);
  border-radius: 4px;
  margin-bottom: 0.5rem;
  font-family: 'Courier New', monospace;
}

/* Map */
.map-container {
  height: calc(100vh - 150px);
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 2px 8px var(--shadow);
}

.leaflet-container {
  height: 100%;
  width: 100%;
  border-radius: 12px;
}

/* Map popup */
.popup-content {
  min-width: 250px;
}

.popup-title {
  font-weight: 600;
  font-size: 1.1rem;
  color: var(--primary-dark);
  margin-bottom: 0.5rem;
}

.popup-info {
  font-size: 0.9rem;
  color: var(--text-light);
  margin-bottom: 0.75rem;
}

.popup-observation {
  background: var(--bg);
  padding: 0.75rem;
  border-radius: 6px;
  font-size: 0.85rem;
  margin-bottom: 0.75rem;
}

.popup-rec {
  padding: 0.5rem;
  background: var(--primary);
  color: white;
  border-radius: 6px;
  font-size: 0.85rem;
}

.severity-badge {
  display: inline-block;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 600;
  margin-left: 0.5rem;
}

.severity-high {
  background: var(--danger);
  color: white;
}

.severity-medium {
  background: var(--warning);
  color: white;
}

/* Loading & Empty states */
.loading,
.empty-state {
  text-align: center;
  padding: 2rem;
  color: var(--text-light);
}

.loading::before {
  content: "⏳";
  display: block;
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

.empty-state::before {
  content: "🌲";
  display: block;
  font-size: 2rem;
  margin-bottom: 0.5rem;
}

/* Scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: var(--bg);
}

::-webkit-scrollbar-thumb {
  background: var(--border);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--text-light);
}

/* Responsive */
@media (max-width: 1400px) {
  .container {
    grid-template-columns: 350px 1fr 300px;
  }
}

@media (max-width: 1024px) {
  .container {
    grid-template-columns: 1fr;
    grid-template-rows: auto auto auto;
  }
  
  .map-container {
    height: 400px;
    order: 1;
  }
}
